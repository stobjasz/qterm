{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the quake window",
  "windows": [
    "quake"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
