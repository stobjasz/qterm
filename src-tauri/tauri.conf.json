{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qterm",
  "version": "0.2.0",
  "identifier": "dev.qterm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "quake",
        "title": "qterm",
        "width": 1200,
        "height": 500,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sebastian Tobjasz",
    "shortDescription": "A quake-style drop-down terminal for Windows",
    "copyright": "Copyright (c) 2026 Sebastian Tobjasz. MIT License.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxOUU3M0YwQTZBMDkzRUEKUldUcWs2Q204SE9lWWU0QXJGWkY0Tjl5c2lXcUU1VjFUbk5HUVI4R0ZwUkdUVEMxNDJhdGpjQVMK",
      "endpoints": [
        "https://github.com/stobjasz/qterm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
